{{define "title"}}Arknet Portal{{end}}
{{define "index"}}
    <h2>Welcome to Arknet Prepaid WiFi</h2>
    <p>Please enter your voucher code to connect.</p>

    {{ if eq .Message "yes" }}
    <div class="error-message" id="error-message">
      Invalid voucher code. Please try again.
    </div>
    {{ end }}

    <form action="/login" method="post">
      <input type="text" name="voucher" placeholder="Enter Voucher Code" required
        maxlength="20" pattern="[A-Za-z0-9]{1,20}"
        title="Letters and numbers only, up to 20 characters"
        autocomplete="off" autocapitalize="off" spellcheck="false"
        oninput="this.value=this.value.replace(/[^A-Za-z0-9]/g,'')">
      <button type="submit">Connect</button>
    </form>
    <div class="footer">
      &copy; 2026 Arknet Prepaid Wifi
    </div>
{{ end }}